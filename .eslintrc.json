{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "prettier"
  ],
  "rules": {
    "prettier/prettier": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-non-null-assertion": "warn",
    "@typescript-eslint/no-require-imports": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "@typescript-eslint/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports"
      }
    ],
    "@typescript-eslint/require-await": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "*.js",
    "*.d.ts",
    "tests/**/*.ts",
    "*.example.ts",
    "vitest.config.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "dashboard/**/*"
  ],
  "overrides": [
    {
      "files": ["src/cli/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/core/adapters/redis*.ts"],
      "rules": {
        "@typescript-eslint/no-redundant-type-constituents": "off"
      }
    },
    {
      "files": ["src/v2/contracts/**/*.ts", "src/v2/kernel/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../write/*", "../read/*", "../indexing/*", "../adapters/*", "../mcp/*"]
          }
        ]
      }
    },
    {
      "files": ["src/v2/write/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../read/*", "../indexing/*", "../adapters/*", "../mcp/*"]
          }
        ]
      }
    },
    {
      "files": ["src/v2/read/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../write/*", "../indexing/*", "../adapters/*", "../mcp/*"]
          }
        ]
      }
    },
    {
      "files": ["src/v2/indexing/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../write/*", "../read/*", "../adapters/*", "../mcp/*"]
          }
        ]
      }
    },
    {
      "files": ["src/v2/mcp/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../adapters/*"]
          }
        ]
      }
    }
  ]
}
